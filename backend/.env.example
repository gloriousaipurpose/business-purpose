# Database setup (SQLite by default for easy local dev, or PostgreSQL)
DATABASE_URL=sqlite:///./radar.db

# Groq AI settings
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
MAX_COST_PER_RUN=0.50

# Source API Keys (Optional - plugins skip if missing)
PRODUCTHUNT_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=BusinessRadar/1.0

# Telegram Notifications (Optional - skipped if missing)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scheduling & App Config
TIMEZONE=Asia/Kolkata
RUN_INTERVAL_HOURS=5
FRONTEND_URL=http://localhost:5173
